EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_WHATSAPP_NUMBER=962792841696

# BUILD-SPEC 23.4: Sentry for crashes and unhandled promise rejections. Empty
# is handled — `src/lib/monitoring.ts` does not start at all without it — and a
# development build never sends even when it is set.
EXPO_PUBLIC_SENTRY_DSN=

# BUILD-SPEC 10.1 and section 24 question 2, answered: the academy's CliQ alias
# and the account holder a player's banking app shows him after he types it.
# Both have the same hardcoded fallback in `src/lib/config.ts`, so a build that
# never sets them still shows the right thing — these exist to change the alias
# without shipping a new binary.
EXPO_PUBLIC_CLIQ_ALIAS=prof2023
EXPO_PUBLIC_CLIQ_ACCOUNT_NAME=MOHAMMAD YOUSEF A. ABUDABBOUR

# The EAS project the push credentials belong to. Without it a build cannot
# register a device token, and no notification reaches it. BUILD-SPEC 18, 2.1.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Section 24 question 8 and 23.3: where the Supabase password reset email
# lands. `docs/` off this repository, deployed by Vercel and served at
# https://professionalofbadminton.com/reset-password/ — the decision and the
# move onto the custom domain are recorded in OPEN-ITEMS.md and
# store/README.md. Set on the EAS `production` environment, not here: a local
# build resets against the local stack, where Supabase's own `site_url`
# applies. Blank is handled — `requestPasswordReset` then omits `redirectTo`.
EXPO_PUBLIC_PASSWORD_RESET_URL=

# A production build refuses to start without the first two of these, so they
# are set on the EAS `production` environment rather than in a committed file.
# See store/README.md for the `eas env:create` lines. BUILD-SPEC 23.2.

# Local Supabase's SMTP password, so a confirmation code reaches a real inbox
# instead of only Mailpit (http://127.0.0.1:54324). Referenced by
# `[auth.email.smtp]` in supabase/config.toml.
#
# Resend: sign up at https://resend.com, then API Keys > Create API Key, with
# "Sending access". The value starts `re_`. The free tier is 100 emails a day.
#
# professionalofbadminton.com is verified in Resend, so the key sends to any
# address. Before that it had to be Resend's shared `onboarding@resend.dev`
# sender, which only ever reached the address the account was opened with.
#
# Leave blank and `supabase start` will fail rather than quietly using Mailpit;
# comment out the `[auth.email.smtp]` block in supabase/config.toml to go back
# to Mailpit deliberately.
SMTP_PASSWORD=

# Sentry's Xcode build phase uploads debug symbols and source maps, and
# `sentry-cli` refuses to run without an organization, a project and an auth
# token. Those belong to a release build (23.4) and are set as EAS secrets, not
# here — so a local build has to be told not to attempt the upload, or
# `xcodebuild` fails with "An organization ID or slug is required".
#
# This only affects builds run from this machine. EAS reads its environment
# from `eas.json`'s `environment` rather than from this file, which is
# gitignored and never reaches it, so release builds still upload symbols.
SENTRY_DISABLE_AUTO_UPLOAD=true

# The From address local Supabase sends confirmation codes from, referenced by
# `[auth.email.smtp]` in supabase/config.toml.
#
# professionalofbadminton.com is verified at resend.com/domains (DKIM, the two
# return-path CNAMEs and DMARC live in Namecheap), so mail from this address
# reaches any player. Resend rejects a From on a domain it has not verified —
# if verification is ever lost, fall back to `onboarding@resend.dev`, which
# needs no DNS but only delivers to the Resend account's own address.
#
# A hosted project ignores this file: pob-prod's sender is set in the Supabase
# dashboard under Authentication > SMTP Settings. See store/README.md.
SMTP_SENDER=noreply@professionalofbadminton.com
