EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_WHATSAPP_NUMBER=962792841696

# BUILD-SPEC 23.4: Sentry for crashes and unhandled promise rejections. Empty
# is handled — `src/lib/monitoring.ts` does not start at all without it — and a
# development build never sends even when it is set.
EXPO_PUBLIC_SENTRY_DSN=

# BUILD-SPEC 10.1 and section 24 question 2. Leave blank until the client says
# what the academy's CliQ alias is; the sheet hides the alias while it is unset.
EXPO_PUBLIC_CLIQ_ALIAS=

# The EAS project the push credentials belong to. Without it a build cannot
# register a device token, and no notification reaches it. BUILD-SPEC 18, 2.1.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Section 24 question 8 and 23.3: where the Supabase password reset email
# lands. A GitHub Pages site under docs/ off this repository —
# https://<owner>.github.io/professional-of-badminton/reset-password/ once
# Pages is switched on — is the decision recorded in OPEN-ITEMS.md and
# store/README.md. Leave blank until that URL exists: `requestPasswordReset`
# then omits `redirectTo` and Supabase falls back to `site_url`, which is the
# same (broken, for a mobile-only app) behaviour the app has always had.
EXPO_PUBLIC_PASSWORD_RESET_URL=

# A production build refuses to start without the first two of these, so they
# are set on the EAS `production` environment rather than in a committed file.
# See store/README.md for the `eas env:create` lines. BUILD-SPEC 23.2.
