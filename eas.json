{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      },
      "ios": {
        "credentialsSource": "local"
      }
    },
    "apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,armeabi-v7a"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "ar-SA",
        "ascAppId": "6807263224",
        "appleTeamId": "LBSMYS2R74",
        "ascApiKeyPath": "/Users/alaaghali/.appstoreconnect/AuthKey_HFDB23UW4R.p8",
        "ascApiKeyId": "HFDB23UW4R",
        "ascApiKeyIssuerId": "01e40122-f36a-4e0e-9919-9ef91fce3314"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
